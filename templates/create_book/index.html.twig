{% extends 'base.html.twig' %}

{% block title %}Créer un livre{% endblock %}

{% block body %}
    <h1>Créer un livre</h1>

    {% for message in app.flashes('success') %}
        <p class="flash-success">{{ message }}</p>
    {% endfor %}

    {{ form_start(form) }}
        {{ form_widget(form) }}
        <button type="submit">Créer</button>
    {{ form_end(form) }}
{% endblock %}
